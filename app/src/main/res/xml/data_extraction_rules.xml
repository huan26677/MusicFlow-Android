<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The refresh token and short-lived OAuth verifier must stay on this device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="musicflow_account_session_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="musicflow_account_session_v1.xml" />
    </device-transfer>
</data-extraction-rules>

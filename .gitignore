!/qa-logs/musicflow-v13-signed-package-api36.log
!/qa-logs/musicflow-v13-signed-smoke-api36.log
/qa-logs/*v13*.json

# v14: do not commit raw QA logs, database metadata or transcripts by default.
/qa-logs/*v14*

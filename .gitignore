
# Gradle and build output
.gradle/
**/build/
.kotlin/

# Local Android SDK settings
local.properties

# Android Studio
.idea/
*.iml
captures/

# Native build
.externalNativeBuild/
.cxx/

# Generated application packages
*.apk
*.aab

# Local sideload demo delivery bundle. Build with scripts/build-musicflow-demo-apk-v1.ps1
# Keep the binary and its checksum off GitHub; the hash is recorded in docs.
/dist/

# Signing keys
*.jks
*.keystore

# Secrets and private configuration
.env
.env.*
secrets.properties
google-services.json

# Local QA account credentials: never commit passwords or email login data.
/docs/Tai_Khoan.md

# Logs
*.log
*.hprof

# Python tooling (local admin uploader)
__pycache__/
*.pyc

# Cho phép lưu log kiểm thử MusicFlow
!qa-logs/
!qa-logs/*.log

# v7: local verbose logs remain on the QA machine; only selected verified
# Android runtime + signed-upgrade transcripts are safe to share in Git.
/qa-logs/*v7*.log
!/qa-logs/musicflow-library-accessibility-v7-full-regression-api30.log
!/qa-logs/musicflow-library-accessibility-v7-targeted-api33.log
!/qa-logs/musicflow-library-accessibility-v7-targeted-api36.log
!/qa-logs/musicflow-library-accessibility-v7-signed-upgrade-api33.log
!/qa-logs/musicflow-library-accessibility-v7-signed-upgrade-api36.log

# v8: only reviewed portable QA transcripts. Build/package logs stay local.
/qa-logs/*v8*.log
!/qa-logs/musicflow-keyboard-searchindex-v8-regression-api30.log
!/qa-logs/musicflow-keyboard-searchindex-v8-targeted-api30.log
!/qa-logs/musicflow-keyboard-searchindex-v8-targeted-api33.log
!/qa-logs/musicflow-keyboard-searchindex-v8-targeted-api36.log
!/qa-logs/musicflow-keyboard-searchindex-v8-signed-upgrade-api33.log
!/qa-logs/musicflow-keyboard-searchindex-v8-signed-upgrade-api36.log
/qa-logs/impact-regression-*.json

# v9: only verified, screened Android QA evidence may be shared in Git.
/qa-logs/*v9*.log
!/qa-logs/musicflow-simple-experience-v9-focused-api30.log
!/qa-logs/musicflow-simple-experience-v9-baseline-api30.log
!/qa-logs/musicflow-simple-experience-v9-signed-upgrade-api30.log

# v10: deny new transcripts by default; explicitly screen before Git upload.
/qa-logs/*v10*.log
!/qa-logs/musicflow-clear-journeys-v10-targeted-api33.log
!/qa-logs/musicflow-clear-journeys-v10-baseline-api33.log
!/qa-logs/musicflow-clear-journeys-v10-targeted-api36.log
!/qa-logs/musicflow-clear-journeys-v10-targeted-api36-single-avd.log
!/qa-logs/musicflow-clear-journeys-v10-signed-upgrade-api33.log

# v11: only reviewable, selected QA transcripts are committed. Device screenshots
# and verbose local diagnostic logs stay on the disposable QA workstation.
/qa-logs/*v11*.log
!/qa-logs/musicflow-keyboard-v11-targeted-api36.log
!/qa-logs/musicflow-keyboard-v11-ux-plus-json-api36.log
!/qa-logs/musicflow-keyboard-v11-json-picker-api36.log
!/qa-logs/musicflow-keyboard-v11-impact-api36.log
!/qa-logs/musicflow-keyboard-v11-impact-retest-api36.log
/qa-logs/v11picker-*.png

# v12: keep large/diagnostic local runs private on the QA workstation.
# Only screened transcripts explicitly named below may be committed.
/qa-logs/*v12*.log
!/qa-logs/musicflow-v12-ux-json-api36.log
!/qa-logs/musicflow-v12-keyboard-standalone-api36.log
!/qa-logs/musicflow-v12-impact67-api36.log
!/qa-logs/musicflow-v12-integrated-flake-api36.log

# v13: deny raw Android instrumentation and build transcripts by default.
# Only reviewed, non-sensitive evidence may be committed with explicit names.
/qa-logs/*v13*.log
!/qa-logs/musicflow-v13-focused-api36.log
!/qa-logs/musicflow-v13-impact67-api36.log
!/qa-logs/musicflow-v13-keyboard-api36.log
!/qa-logs/musicflow-v13-album-api36.log
!/qa-logs/musicflow-v13-search-api36.log

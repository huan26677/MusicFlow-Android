{
  "schema": 1,
  "policy": {
    "direct": "Run every available case owned by the directly changed module.",
    "dependent": "Run designated smoke/contract cases for every transitive downstream consumer.",
    "risk": "Permission, Room/SAF persistence, roles/security, billing, manifest/build, or unknown source changes require full/acceptance review; a selective green run alone cannot close them.",
    "release": "Final school demo APK, shared cross-module contract changes, and repeated failures also require full regression and signed upgrade verification.",
    "no_claim": "Selection is a plan, not a test run or a PASS claim. Missing/unmapped test cases must be treated as coverage gaps."
  },
  "global_full_patterns": [
    "app/build.gradle.kts", "build.gradle.kts", "settings.gradle.kts",
    "gradle.properties", "gradle/**", "app/src/main/AndroidManifest.xml",
    "app/src/main/java/com/example/musicflow/MainActivity.kt",
    "app/src/main/java/com/example/musicflow/navigation/**",
    ".github/workflows/**",
    "app/src/main/java/com/example/musicflow/ui/theme/**"
  ],
  "high_risk_patterns": [
    "app/src/main/java/com/example/musicflow/core/media/LocalPickedMusicStore.kt",
    "app/src/main/java/com/example/musicflow/core/account/MusicFlowAccess.kt",
    "app/src/main/java/com/example/musicflow/core/account/AccountApi.kt",
    "app/src/main/java/com/example/musicflow/core/account/GoogleOAuthFlow.kt",
    "app/src/main/java/com/example/musicflow/core/account/DemoPasswordHash.kt",
    "app/src/main/java/com/example/musicflow/core/account/CloudLibrarySync.kt",
    "app/src/main/java/com/example/musicflow/core/account/CloudHistorySync.kt",
    "admin-web/**",
    "app/src/main/java/com/example/musicflow/core/playlist/**Database*",
    "app/src/main/java/com/example/musicflow/core/history/**Database*",
    "app/src/main/java/com/example/musicflow/core/account/DemoBillingStore.kt",
    "app/src/main/java/com/example/musicflow/core/community/SupabaseCommunityRepository.kt",
    "app/src/main/java/com/example/musicflow/feature/community/CommunityModerationPanel.kt",
    "docs/sql/musicflow_community_*.sql",
    "scripts/build-musicflow-demo-apk-v1.ps1",
    "scripts/run-signed-upgrade-*.ps1"
  ],
  "non_runtime_patterns": [
    "docs/**", "qa/**", "scripts/impact_regression.py",
    "scripts/test_impact_regression.py", "scripts/project_brain_v2.py",
    "scripts/test_project_brain_v2.py", "README.md", "AGENTS.md",
    ".gitignore", "qa-logs/**",
    "scripts/sql/musicflow_community_rollback_contract_v14_1.sql",
    "scripts/test_community_moderation_sql_v14.py"
  ],
  "modules": [
    {
      "id": "MEDIA_SAF", "name": "MediaStore, tệp offline và quyền SAF",
      "source": ["app/src/main/java/com/example/musicflow/core/media/**"],
      "requires": [],
      "tests": ["**/core/media/*Test.kt", "**/core/playback/RealPickerSafTest.kt", "**/core/playback/SafPermissionRestartTest.kt", "**/ui/PlaylistQuickAddRealSafUiTest.kt", "**/ui/OfflineReliabilityUiTest.kt"],
      "smoke": ["OfflineDiscoveryMediaStoreTest#scansLongWavInMusicWhenProviderInitiallyMarksItNonMusic", "RealPickerSafTest#realOpenMultipleDocumentsGrantsPersistedReadAndPlays", "SafPermissionRestartTest#verifySafAfterForceStop"]
    },
    {
      "id": "LIBRARY", "name": "Thư viện, album, nghệ sĩ, thể loại",
      "source": ["app/src/main/java/com/example/musicflow/feature/library/**", "app/src/main/java/com/example/musicflow/core/catalog/**", "app/src/main/java/com/example/musicflow/feature/catalog/**"],
      "requires": ["MEDIA_SAF", "FAVORITES", "UI_ACCESS"],
      "tests": ["**/feature/library/LibraryAccessibilityV7Test.kt", "**/ui/LibraryPerformanceV4UiTest.kt", "**/core/playback/AdvancedLibraryRuntimeTest.kt", "**/ui/MusicFlowPlayerLibraryUxV3Test.kt"],
      "smoke": ["LibraryPerformanceV4UiTest#songSearchPlaysOnlyFilteredQueueAndPreservesIndex", "LibraryAccessibilityV7Test#albumTracksStayVirtualizedInRealLibraryAt200Percent"]
    },
    {
      "id": "SEARCH", "name": "Tìm kiếm không dấu, chỉ mục, lọc nhóm",
      "source": ["app/src/main/java/com/example/musicflow/feature/search/**"],
      "requires": ["MEDIA_SAF", "LIBRARY", "UI_ACCESS"],
      "tests": ["**/feature/search/*Test.kt", "**/core/playback/AdvancedSearchRuntimeTest.kt", "**/ui/MusicFlowSearchUxV3Test.kt", "**/ui/AccessibilityOfflineSearchV5Test.kt"],
      "smoke": ["AdvancedSearchIndexV8Test#refreshRevocationAndQueryChangesDoNotReuseStaleCatalog", "AdvancedSearchRuntimeTest#searchRouteAccentInsensitivePlaybackAndQueueActions"]
    },
    {
      "id": "PLAYBACK", "name": "Player service, hàng đợi, runtime, audio focus",
      "source": ["app/src/main/java/com/example/musicflow/core/playback/**", "app/src/main/java/com/example/musicflow/feature/player/**"],
      "requires": ["MEDIA_SAF", "ONLINE_RIGHTS", "UI_ACCESS"],
      "tests": ["**/core/playback/*Test.kt", "**/ui/MusicFlowPlayerLibraryUxV3Test.kt"],
      "smoke": ["PlaybackQueuePersistenceTest#savedQueueRestoresPausedAndResumesPlayback", "PlaybackRuntimeAutoSkipTest#singleMissingTrackAutoSkips"]
    },
    {
      "id": "PLAYLIST", "name": "Playlist Room, reorder, import/export",
      "source": ["app/src/main/java/com/example/musicflow/core/playlist/**", "app/src/main/java/com/example/musicflow/feature/playlist/**"],
      "requires": ["MEDIA_SAF", "PLAYBACK", "UI_ACCESS"],
      "tests": ["**/core/playlist/*Test.kt", "**/feature/playlist/*Test.kt", "**/ui/Playlist*Test.kt", "**/ui/MusicFlowPlaylistPolishV3Test.kt"],
      "smoke": ["PlaylistReorderDatabaseTest#reorderPersistsAfterDatabaseReopen", "PlaylistLocalBackupIntegrationTest#invalidDocumentCannotPartiallyModifyRoom"]
    },
    {
      "id": "FAVORITES", "name": "Yêu thích bài hát và album",
      "source": ["app/src/main/java/com/example/musicflow/core/favorites/**"],
      "requires": ["MEDIA_SAF", "UI_ACCESS"],
      "tests": ["**/FavoritesBatchTest.kt", "**/ui/SmartLibraryUiTest.kt"],
      "smoke": ["SmartLibraryUiTest#changingFavoriteRecomputesSmartCollectionImmediately"]
    },
    {
      "id": "SMART", "name": "Smart Library và gợi ý thư viện",
      "source": ["app/src/main/java/com/example/musicflow/core/smart/**", "app/src/main/java/com/example/musicflow/feature/library/Smart*"],
      "requires": ["LIBRARY", "FAVORITES", "HISTORY", "UI_ACCESS"],
      "tests": ["**/core/smart/*Test.kt", "**/ui/SmartLibraryUiTest.kt"],
      "smoke": ["SmartLibraryUiTest#pickedTrackAndMediaStoreDuplicateAppearOnlyOnceInSmartMix"]
    },
    {
      "id": "HISTORY", "name": "Lịch sử nghe và Room recent",
      "source": ["app/src/main/java/com/example/musicflow/core/history/**"],
      "requires": ["PLAYBACK"],
      "tests": ["**/core/history/*Test.kt"],
      "smoke": ["RecentHistoryDatabaseTest#historySurvivesDatabaseReopen"]
